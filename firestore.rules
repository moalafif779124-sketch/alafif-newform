rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    // Stock-only decrement guard for customer order placement.
    function stockDecrementOnly() {
      let next = request.resource.data;
      let prev = resource.data;
      let variantsOk = !('stockVariants' in prev)
        ? next.stockVariants.size() == 0
        : next.stockVariants.keys().hasOnly(prev.stockVariants.keys());
      return next.diff(prev).affectedKeys()
               .hasOnly(['stockQuantity', 'stockVariants', 'stockUpdatedAt'])
        && next.stockQuantity is int
        && next.stockQuantity >= 0
        && next.stockQuantity <= prev.stockQuantity
        && variantsOk;
    }

    match /products/{docId} {
      allow read: if true;
      allow write: if isAdmin();

      // Signed-in customers may ONLY decrement tracked stock while placing an
      // order (atomic Firestore transaction in the app). They can never raise a
      // value, go negative, touch other fields, or add/remove variant sizes.
      // Admin keeps unrestricted write above.
      allow update: if isSignedIn() && stockDecrementOnly();
    }
    match /banners/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /categories/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /flash_sales/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /app_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /reviews/{docId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // restock requests - customers create + read their own; admin reads/updates
    match /restock_requests/{docId} {
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow update, delete: if isAdmin();
    }

    // in-store smart mode: fitting room requests
    // customers dispatch a request for their own session; staff (admin) handles it
    match /fitting_room_requests/{docId} {
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow read: if isOwner(resource.data.userId) || isAdmin();
      // staff drive the lifecycle; the owner may only cancel their own pending request
      allow update: if isAdmin() ||
        (isOwner(resource.data.userId) &&
         resource.data.status == 'pending' &&
         request.resource.data.status == 'cancelled' &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'cancelledAt', 'updatedAt', 'cancelledBy']));
      allow delete: if isAdmin();
    }

    // branches - public read (displayed in the in-store branch picker), admin write
    match /branches/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // users - owner or admin; legacy phone_* docs readable for migration.
    // SECURITY: a customer must NEVER be able to change their own privilege or
    // moderation fields (isAdmin/role/status/...). Anything not whitelisted
    // below is admin-only.
    match /users/{userId} {
      function selfOrLegacy() {
        return isOwner(userId) || (isSignedIn() && userId.matches('^phone_.*'));
      }
      function profileFieldsOnly() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'fullName', 'phone', 'email', 'photoUrl', 'avatar',
          'address', 'addresses', 'city', 'district', 'street', 'notes',
          'fcmTokens', 'lastLogin', 'lastSeen', 'createdAt', 'updatedAt',
          'points', 'lifetimePoints', 'streakDays', 'lastCheckin', 'badges',
          'referralCode', 'referredBy', 'notificationTopics',
          'preferredLanguage', 'notificationsEnabled', 'darkMode', 'settings',
          'id'
        ]);
      }
      allow read: if isOwner(userId) || isAdmin();
      allow read: if isSignedIn() && userId.matches('^phone_.*');
      // cannot self-register as admin
      allow create: if selfOrLegacy()
        && request.resource.data.get('isAdmin', false) == false;
      // role can only be granted by an admin, never by the account holder
      allow update: if isAdmin() || (selfOrLegacy()
        && request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false)
        && profileFieldsOnly());
      allow delete: if isAdmin();
    }
    // orders - a customer may only CANCEL their own order; totals, status and
    // items are admin-only after creation. Discount is capped at 50% of the
    // subtotal so a tampered client cannot self-approve a free order.
    match /orders/{orderId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && (!('discount' in request.resource.data)
            || request.resource.data.discount >= 0)
        && (!('discount' in request.resource.data)
            || !('subtotal' in request.resource.data)
            || request.resource.data.discount <= request.resource.data.subtotal * 0.5);
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow update: if isAdmin() || (isOwner(resource.data.userId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'cancelReason', 'cancelledAt'])
        && request.resource.data.status == 'cancelled');
      allow delete: if isAdmin();
    }
    match /addresses/{docId} {
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isOwner(resource.data.userId) || isAdmin();
    }
    match /carts/{docId} {
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isOwner(resource.data.userId) || isAdmin();
    }
    match /wishlists/{docId} {
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isOwner(resource.data.userId) || isAdmin();
    }
    // points history (subcollection of users) - owner reads/writes own records
    match /users/{userId}/points_history/{docId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
    // referral codes - public lookup by code; creation only by the code owner
    match /referral_codes/{code} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }
    // referral events - referee creates; referrer claims; both can read
    match /referrals/{docId} {
      allow read: if isSignedIn() &&
        (resource.data.refereeUid == request.auth.uid ||
         resource.data.referrerUid == request.auth.uid);
      // no self-referral: referrer must be someone else
      allow create: if isSignedIn() &&
        request.resource.data.refereeUid == request.auth.uid &&
        request.resource.data.referrerUid != request.auth.uid;
      allow update: if isSignedIn() &&
        resource.data.referrerUid == request.auth.uid;
      allow delete: if false;
    }
    match /points_history/{docId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if isAdmin();
    }

    // any other document - admin only
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
