rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /products/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /banners/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /categories/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /flash_sales/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /app_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /reviews/{docId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // users - owner or admin; legacy phone_* docs readable for migration
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
      allow read: if isSignedIn() && userId.matches('^phone_.*');
    }
    match /orders/{orderId} {
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow read, update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isAdmin();
    }
    match /addresses/{docId} {
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isOwner(resource.data.userId) || isAdmin();
    }
    match /carts/{docId} {
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isOwner(resource.data.userId) || isAdmin();
    }
    match /wishlists/{docId} {
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isOwner(resource.data.userId) || isAdmin();
    }
    // points history (subcollection of users) - owner reads/writes own records
    match /users/{userId}/points_history/{docId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
    // referral codes - public lookup by code; creation only by the code owner
    match /referral_codes/{code} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }
    // referral events - referee creates; referrer claims; both can read
    match /referrals/{docId} {
      allow read: if isSignedIn() &&
        (resource.data.refereeUid == request.auth.uid ||
         resource.data.referrerUid == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.refereeUid == request.auth.uid;
      allow update: if isSignedIn() &&
        resource.data.referrerUid == request.auth.uid;
      allow delete: if false;
    }
    match /points_history/{docId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if isAdmin();
    }

    // any other document - admin only
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
