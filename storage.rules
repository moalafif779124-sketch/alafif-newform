rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // products - public read; write allowed (OTP admin has no Firebase Auth session)
    match /products/{fileName} {
      allow read: if true;
      allow write: if true;
    }

    // users - public read; write allowed
    match /users/{userId}/{fileName} {
      allow read: if true;
      allow write: if true;
    }

    // reviews - public read; write allowed (OTP customers upload review photos)
    match /reviews/{productId}/{fileName} {
      allow read: if true;
      allow write: if true;
    }

    // everything else - read only
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
