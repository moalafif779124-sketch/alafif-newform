rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // products - public read; write requires Firebase session (anonymous OTP auth ok)
    match /products/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // users - public read; write requires Firebase session
    match /users/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // reviews - public read; write requires Firebase session (OTP users get anonymous auth)
    match /reviews/{productId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // everything else - read only
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
